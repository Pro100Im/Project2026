<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Global/GlobalStyle.uss?fileID=7433441132597879392&amp;guid=f0b50401ae793a440bdbacc20d05f547&amp;type=3#GlobalStyle"/>
    <Style src="TownChrome.uss" />
    <Style src="project://database/Assets/UI%20Toolkit/Town/TownBuildMenu.uss?fileID=7433441132597879392&amp;guid=717f716ece1640368b7d001a00317038&amp;type=3#TownBuildMenu"/>
    <Style src="project://database/Assets/UI%20Toolkit/Town/TownResearchMenu.uss?fileID=7433441132597879392&amp;guid=b4d0f82914c691356728394a5b6c7d8e&amp;type=3#TownResearchMenu"/>
    <ui:VisualElement name="TownResearchMenu" picking-mode="Position" class="build-menu-overlay hide" style="display: none;">
        <ui:VisualElement name="TownResearchPanel" picking-mode="Position" class="research-panel">
            <Code.Meta.UI.Common.NinePiecePanel class="nine--paper"/>
            <ui:VisualElement name="TownResearchTree" picking-mode="Position" class="research-tree"/>
            <ui:VisualElement picking-mode="Ignore" class="panel-title-row">
                <ui:VisualElement picking-mode="Ignore" class="ribbon-title">
                    <Code.Meta.UI.Common.NinePiecePanel class="nine--ribbon-blue"/>
                    <ui:Label text="Research" name="TownResearchTitle" picking-mode="Ignore" class="ribbon-title__label"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="TownResearchDetail" picking-mode="Position" class="research-detail" style="display: none;">
                <Code.Meta.UI.Common.NinePiecePanel class="nine--paper"/>
                <ui:VisualElement picking-mode="Ignore" class="panel-title-row">
                    <ui:VisualElement picking-mode="Ignore" class="ribbon-title">
                        <Code.Meta.UI.Common.NinePiecePanel class="nine--ribbon-yellow"/>
                        <ui:Label text="" name="TownResearchDetailTitle" picking-mode="Ignore" class="ribbon-title__label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Image name="TownResearchDetailIcon" picking-mode="Ignore" class="research-detail__icon"/>
                <ui:Label text="" name="TownResearchDetailDescription" picking-mode="Ignore" class="research-detail__description"/>
                <ui:VisualElement picking-mode="Ignore" class="research-detail__price-row">
                    <ui:VisualElement picking-mode="Ignore" class="research-detail__price-icon res-knowledge"/>
                    <ui:Label text="" name="TownResearchDetailPrice" picking-mode="Ignore" class="research-detail__price"/>
                </ui:VisualElement>
                <ui:Button text="" name="TownResearchDetailBuy" class="pixel-button research-detail__buy">
                    <Code.Meta.UI.Common.NinePiecePanel class="nine--blue"/>
                    <ui:Label text="Buy" name="TownResearchDetailBuyLabel" picking-mode="Ignore" class="pixel-button__label"/>
                </ui:Button>
                <ui:Button text="" name="TownResearchDetailClose" class="build-menu-close"/>
            </ui:VisualElement>
            <ui:Button text="" name="TownResearchCloseButton" class="build-menu-close"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
