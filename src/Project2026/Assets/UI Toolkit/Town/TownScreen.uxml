<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="TownExchequer" src="project://database/Assets/UI%20Toolkit/Town/TownExchequer.uxml?fileID=9197481963319205126&amp;guid=0374e6f93bbe0aa4bb76400cbfb1150d&amp;type=3#TownExchequer"/>
    <ui:Template name="TownBuildMenu" src="project://database/Assets/UI%20Toolkit/Town/TownBuildMenu.uxml?fileID=9197481963319205126&amp;guid=414060676b43471b95f7d9f6c4c9d0af&amp;type=3#TownBuildMenu"/>
    <ui:Template name="TownResearchMenu" src="project://database/Assets/UI%20Toolkit/Town/TownResearchMenu.uxml?fileID=9197481963319205126&amp;guid=a3c9e71803b58024561728394a5b6c7d&amp;type=3#TownResearchMenu"/>
    <ui:Template name="TownEquipmentMenu" src="project://database/Assets/UI%20Toolkit/Town/TownEquipmentMenu.uxml?fileID=9197481963319205126&amp;guid=f1a2b3c4d5e64789a0b1c2d3e4f50617&amp;type=3#TownEquipmentMenu"/>
    <Style src="project://database/Assets/UI%20Toolkit/Global/GlobalStyle.uss?fileID=7433441132597879392&amp;guid=f0b50401ae793a440bdbacc20d05f547&amp;type=3#GlobalStyle"/>
    <Style src="../Global/MenuChrome.uss" />
    <ui:VisualElement name="TowerCanvas" picking-mode="Ignore" class="screen-root">
        <ui:Instance template="TownBuildMenu" name="TownBuildMenuRoot" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        <ui:Instance template="TownResearchMenu" name="TownResearchMenuRoot" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        <ui:Instance template="TownEquipmentMenu" name="TownEquipmentMenuRoot" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
        <ui:Instance template="TownExchequer" style="position: absolute; right: 0;"/>
        <ui:Button text="" name="ExitButton" class="hud-gear">
            <ui:Image picking-mode="Ignore" name="Icon" class="hud-gear__icon menu-icon-exit"/>
        </ui:Button>
        <ui:Button text="" name="ResearchButton" class="button town-research">
            <ui:Label text="RESEARCH" picking-mode="Ignore" class="commonText"/>
        </ui:Button>
        <ui:Button text="" name="EquipmentButton" class="button town-equipment">
            <ui:Label text="EQUIP" picking-mode="Ignore" class="commonText"/>
        </ui:Button>
        <ui:Button text="" name="TownButton" class="button town-build">
            <ui:Image picking-mode="Ignore" name="Icon" class="town-build__icon"/>
            <ui:Label text="BUILD" picking-mode="Ignore" class="commonText"/>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
