.equipment-slots {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: 12px;
}

.equipment-slots > .build-slot,
.equipment-choices > .build-slot {
    margin: 5px 8px;
}

.equipment-choices {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: 18px;
}

.equipment-choice:disabled {
    opacity: 0.5;
}

.equipment-slot--selected {
    -unity-background-image-tint-color: rgb(255, 224, 130);
    scale: 1.06 1.06;
}

.equipment-empty {
    margin-top: 16px;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.equipment-clear {
    width: 230px;
    height: 98px;
    margin-top: 14px;
}
