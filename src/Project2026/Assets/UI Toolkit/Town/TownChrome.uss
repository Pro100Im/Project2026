/* ---- Buttons ---- */
.pixel-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 98px;
    margin: 0;
    /* The bottom of the sprite is the button's lip, the face sits above it. */
    padding: 0 26px 16px 26px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: scale, translate;
    transition-duration: 0.1s;
    transition-timing-function: ease-out-cubic;
}

.pixel-button:hover,
.pixel-button:active,
.pixel-button:focus,
.pixel-button:disabled {
    background-color: rgba(0, 0, 0, 0);
}

.pixel-button:hover:enabled {
    scale: 1.04 1.04;
}

.pixel-button:active:enabled {
    scale: 1 1;
    translate: 0 4px;
}

.pixel-button:active:enabled .nine__piece {
    -unity-background-image-tint-color: rgb(205, 205, 215);
}

.pixel-button:disabled {
    opacity: 1;
}

.pixel-button:disabled .nine__piece {
    -unity-background-image-tint-color: rgb(150, 150, 150);
}

.pixel-button:disabled .pixel-button__label {
    color: rgb(215, 215, 215);
}

.pixel-button__label {
    margin: 0;
    padding: 0;
    color: rgb(255, 246, 220);
    font-size: 34px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/ThaleahFat%20SDF.asset?fileID=11400000&guid=4f91cd89f157d37449660700b7886222&type=2#ThaleahFat SDF");
    -unity-text-outline-color: rgb(28, 36, 58);
    -unity-text-outline-width: 1.5px;
}

/* ---- Ribbon title, sits on the top edge of a panel ---- */
.panel-title-row {
    position: absolute;
    left: 0;
    right: 0;
    top: -40px;
    align-items: center;
}

.ribbon-title {
    height: 84px;
    min-width: 340px;
    padding: 0 96px 10px 96px;
    align-items: center;
    justify-content: center;
}

.ribbon-title__label {
    margin: 0;
    padding: 0;
    color: rgb(255, 246, 220);
    font-size: 40px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/ThaleahFat%20SDF.asset?fileID=11400000&guid=4f91cd89f157d37449660700b7886222&type=2#ThaleahFat SDF");
    -unity-text-outline-color: rgb(28, 36, 58);
    -unity-text-outline-width: 1.5px;
}

/* ---- Resources: one wooden bar in the top-right corner ---- */
.town-resources {
    position: absolute;
    top: 12px;
    right: 16px;
    height: 108px;
    flex-direction: row;
    align-items: center;
    padding: 12px 30px 30px 30px;
}

.town-resource {
    flex-direction: row;
    align-items: center;
    margin: 0 10px;
}

.town-resource__icon {
    width: 46px;
    height: 46px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.town-resource__value {
    min-width: 54px;
    margin: 0;
    padding: 0;
    font-size: 36px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/ThaleahFat%20SDF.asset?fileID=11400000&guid=4f91cd89f157d37449660700b7886222&type=2#ThaleahFat SDF");
    -unity-text-outline-color: rgb(40, 22, 12);
    -unity-text-outline-width: 1.5px;
}

.res-wood { background-image: url("project://database/Assets/Sources/Tiny%20Swords%20(Free%20Pack)/Tiny%20Swords%20(Free%20Pack)/UI%20Elements/UI%20Elements/Icons/Icon_02.png?fileID=2800000&guid=4e30bae39ecc4c44f9fe6b924646dff6&type=3#Icon_02"); }
.res-stone { background-image: url("project://database/Assets/Sources/My/Other/Misc/Rune%20Stone.png?fileID=2800000&guid=e6d5c417c1975dd4ab0783000ef7f95d&type=3#Rune Stone"); }
.res-crystal { background-image: url("project://database/Assets/Sources/My/Other/Ore%20&%20Gem/Diamond.png?fileID=2800000&guid=33c9e896bd5e7e94cadec9bc8c1c3d59&type=3#Diamond"); }
.res-knowledge { background-image: url("project://database/Assets/Sources/My/Other/Misc/Book%203.png?fileID=2800000&guid=9486262587cd2c743a5de378c0d39ebe&type=3#Book 3"); }
.res-gold { background-image: url("project://database/Assets/Sources/My/Other/Misc/Golden%20Coin.png?fileID=2800000&guid=394899dbf2938874ca7d1025f7598406&type=3#Golden Coin"); }

.res-wood-text { color: rgb(226, 160, 122); }
.res-stone-text { color: rgb(222, 214, 202); }
.res-crystal-text { color: rgb(158, 215, 255); }
.res-knowledge-text { color: rgb(190, 160, 255); }
.res-gold-text { color: rgb(243, 218, 91); }

/* ---- Bottom actions: Research, Build, Equip ---- */
.town-actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.town-action {
    width: 276px;
    height: 104px;
    margin: 0 14px;
}

.town-action--main {
    width: 316px;
    height: 120px;
}

.town-action--main .pixel-button__label {
    font-size: 40px;
}

.town-action__icon {
    width: 54px;
    height: 54px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

