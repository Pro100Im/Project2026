<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Global/GlobalStyle.uss?fileID=7433441132597879392&amp;guid=f0b50401ae793a440bdbacc20d05f547&amp;type=3#GlobalStyle"/>
    <Style src="../Global/MenuChrome.uss" />
    <ui:VisualElement name="MainMenuCanvas" picking-mode="Ignore" class="main-menu-canvas">
        <ui:Label text="The Last Castle" name="Title" picking-mode="Ignore" class="titleText main-menu-title"/>
        <ui:VisualElement name="MainMenu" picking-mode="Ignore" class="hide menu-fade">
            <ui:VisualElement name="ButtonContainer" picking-mode="Ignore" class="menu-panel">
                <ui:VisualElement name="Choices" picking-mode="Ignore" class="menu-choices">
                    <ui:Button text="" name="QuickPlayButton" class="button commonText menu-choice">
                        <ui:Image name="Icon" picking-mode="Ignore" class="menu-choice__icon menu-icon-restart"/>
                        <ui:Label text="Quick Play" picking-mode="Ignore" class="commonText"/>
                    </ui:Button>
                    <ui:Button text="" name="TownButton" class="button commonText menu-choice">
                        <ui:Image name="Icon" picking-mode="Ignore" class="menu-choice__icon menu-icon-house"/>
                        <ui:Label text="Town" picking-mode="Ignore" class="commonText"/>
                    </ui:Button>
                    <ui:Button text="" name="SettingsButton" class="button commonText menu-choice">
                        <ui:Image name="Icon" picking-mode="Ignore" class="menu-choice__icon menu-icon-settings"/>
                        <ui:Label text="Settings" picking-mode="Ignore" class="commonText"/>
                    </ui:Button>
                    <ui:Button text="" name="ExitButton" class="button commonText menu-choice">
                        <ui:Image name="Icon" picking-mode="Ignore" class="menu-choice__icon menu-icon-exit"/>
                        <ui:Label text="Exit" picking-mode="Ignore" class="commonText"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SearchingPopUp" picking-mode="Ignore" class="hide menu-fade menu-search">
            <ui:Label picking-mode="Ignore" text="Searching..." class="commonText"/>
            <ui:Button text="" name="CancelButton" class="button commonText menu-choice">
                <ui:Label text="Cancel" picking-mode="Ignore" class="commonText"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="Intro" picking-mode="Ignore" class="menu-fade main-menu-intro">
            <ui:Label text="PRESS ANY BUTTON" picking-mode="Ignore" class="commonText"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
