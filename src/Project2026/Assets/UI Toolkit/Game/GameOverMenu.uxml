<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Global/GlobalStyle.uss?fileID=7433441132597879392&amp;guid=f0b50401ae793a440bdbacc20d05f547&amp;type=3#GlobalStyle"/>
    <ui:VisualElement name="Canvas" picking-mode="Ignore" style="flex-grow: 1;">
        <ui:VisualElement name="GameOverMenu" picking-mode="Ignore" focusable="false" enabled="true" class="hide" style="flex-grow: 1; position: relative; align-items: center; align-content: center; align-self: auto; justify-content: center; transition-property: opacity; transition-duration: 0.2s; bottom: auto; right: auto; flex-wrap: nowrap;">
            <ui:Image name="Mask" picking-mode="Ignore" style="position: absolute; background-color: rgba(34, 34, 34, 0.58); align-content: stretch; justify-content: space-evenly; align-self: stretch; height: 1080px; width: 1920px; left: 0;"/>
            <ui:Label text="Game Over" name="Title" picking-mode="Ignore" class="titleText" style="top: 98px; position: absolute;"/>
            <ui:VisualElement name="Back" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sources/Tiny%20Swords%20(Free%20Pack)/Tiny%20Swords%20(Free%20Pack)/UI%20Elements/UI%20Elements/Banners/Banner_Slots.png?fileID=2800000&amp;guid=072717bc57c49fe4b8d08208e4b8c83c&amp;type=3#Banner_Slots&quot;); width: 500px; height: 500px; position: absolute; -unity-background-scale-mode: scale-and-crop; background-position-y: center; background-size: 100% 100%; flex-wrap: nowrap; justify-content: center; align-items: center; align-self: center; align-content: center; max-width: none; max-height: none; margin-bottom: 0; background-position-x: center; top: auto; left: auto; bottom: auto; right: auto; -unity-background-image-tint-color: rgba(255, 255, 255, 0.9);"/>
            <ui:VisualElement name="ButtonsContainer" picking-mode="Ignore" style="flex-grow: 1; white-space: nowrap; -unity-text-align: middle-left; flex-wrap: wrap; flex-direction: row; align-self: center; justify-content: center; align-items: center; align-content: center; height: 400px; width: 450px; position: absolute;">
                <ui:Button text="SETTINGS" name="ArcherTower" picking-mode="Ignore" class="button commonText" style="margin-left: 25px; -unity-text-align: middle-center; white-space: nowrap; -unity-text-generator: standard; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                    <ui:Image name="Icon" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sources/Tiny%20Swords%20(Free%20Pack)/Tiny%20Swords%20(Free%20Pack)/UI%20Elements/UI%20Elements/Icons/Icon_05.png?fileID=2800000&amp;guid=9fd214d87b23d4c45adcbc81b4d58dc3&amp;type=3#Icon_05&quot;); -unity-background-scale-mode: scale-to-fit; margin-bottom: 22px; left: 0; width: 100px; margin-left: 74px; margin-top: 19px;"/>
                </ui:Button>
                <ui:Button text="TOWN" name="ArcherTower" picking-mode="Ignore" class="commonText button" style="margin-left: 25px; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
                    <ui:Image name="Icon" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sources/Tiny%20Swords%20(Free%20Pack)/Tiny%20Swords%20(Free%20Pack)/UI%20Elements/UI%20Elements/Icons/Icon_01.png?fileID=2800000&amp;guid=3d7574687a3e0f74b80eaa957215e5f5&amp;type=3#Icon_01&quot;); -unity-background-scale-mode: scale-to-fit; margin-bottom: 22px; left: 0; width: 100px; margin-left: 74px; margin-top: 19px;"/>
                </ui:Button>
                <ui:Button text="EXIT" name="ExitButton" picking-mode="Ignore" class="commonText button" style="margin-left: 25px; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0);">
                    <ui:Image name="Icon" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sources/Tiny%20Swords%20(Free%20Pack)/Tiny%20Swords%20(Free%20Pack)/UI%20Elements/UI%20Elements/Icons/Icon_08.png?fileID=2800000&amp;guid=eb11edec265f9eb42b9fee820381fede&amp;type=3#Icon_08&quot;); -unity-background-scale-mode: scale-to-fit; margin-bottom: 22px; left: 0; width: 100px; margin-left: 74px; margin-top: 19px;"/>
                </ui:Button>
