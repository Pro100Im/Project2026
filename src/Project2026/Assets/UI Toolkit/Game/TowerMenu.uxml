<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Global/GlobalStyle.uss?fileID=7433441132597879392&amp;guid=f0b50401ae793a440bdbacc20d05f547&amp;type=3#GlobalStyle"/>
    <Style src="../Global/MenuChrome.uss" />
    <ui:VisualElement name="Canvas" picking-mode="Ignore" class="screen-root">
        <ui:VisualElement name="TowerBuildMenu" picking-mode="Ignore" focusable="false" class="hide menu-pop">
            <ui:VisualElement name="Back" picking-mode="Ignore" class="menu-panel menu-panel--build">
                <ui:Label text="BUILD" name="TowerBuildTitle" picking-mode="Ignore" class="menu-title"/>
                <ui:VisualElement name="TowerBuildsContainer" picking-mode="Ignore" class="tower-row">
                    <ui:Button text="" name="ArcherTower" class="tower-slot tower-choice">
                        <ui:Image name="Icon" picking-mode="Ignore" class="tower-choice__icon tower-icon-archer"/>
                        <ui:Label text="ARCHER" picking-mode="Ignore" class="captionText"/>
                    </ui:Button>
                    <ui:Button text="" name="IceTower" class="tower-slot tower-choice">
                        <ui:Image name="Icon" picking-mode="Ignore" class="tower-choice__icon tower-icon-ice"/>
                        <ui:Label text="ICE" picking-mode="Ignore" class="captionText"/>
                    </ui:Button>
                    <ui:Button text="" name="FireTower" class="tower-slot tower-choice">
                        <ui:Image name="Icon" picking-mode="Ignore" class="tower-choice__icon tower-icon-fire"/>
                        <ui:Label text="FIRE" picking-mode="Ignore" class="captionText"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button text="" name="TowerBuildsCloseButton" class="menu-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TowerUpgradeMenu" picking-mode="Ignore" focusable="false" class="hide menu-pop">
            <ui:VisualElement name="Back" picking-mode="Ignore" class="menu-panel menu-panel--upgrade">
                <ui:Label text="UPGRADE" name="TowerUpgradeTitle" picking-mode="Ignore" class="menu-title"/>
                <ui:VisualElement name="TowerUpgradesContainer" picking-mode="Ignore" class="tower-row">
                    <ui:Button text="" name="TowerUpgrade1" class="tower-slot tower-choice">
                        <ui:Image name="UpgradeIcon1" picking-mode="Ignore" class="tower-choice__icon"/>
                        <ui:Label text="I" picking-mode="Ignore" class="captionText"/>
                    </ui:Button>
                    <ui:Button text="" name="TowerUpgrade2" class="tower-slot tower-choice">
                        <ui:Image name="UpgradeIcon2" picking-mode="Ignore" class="tower-choice__icon"/>
                        <ui:Label text="II" picking-mode="Ignore" class="captionText"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button text="" name="TowerUpgradesCloseButton" class="menu-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
