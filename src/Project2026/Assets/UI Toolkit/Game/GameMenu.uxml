            <ui:VisualElement name="TowerBuildsContainer" picking-mode="Ignore" style="flex-grow: 1; white-space: nowrap; -unity-text-align: middle-left; flex-wrap: wrap; flex-direction: row; align-self: center; justify-content: center; align-items: center; align-content: center; height: 400px; width: 450px; position: absolute;">
                <ui:Button text="SETTINGS" name="ArcherTower" picking-mode="Ignore" class="button commonText" style="margin-left: 25px; -unity-text-align: middle-center; white-space: nowrap; -unity-text-generator: standard;">
                    <ui:Image name="Icon" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sources/Tiny%20Swords/UI%20Elements/Icons/Icon_10.png?fileID=21300000&amp;guid=7648749918456470a9281327b80aa3bb&amp;type=3#Icon_10&quot;); -unity-background-scale-mode: scale-to-fit; margin-bottom: 22px; left: 0; width: 100px; margin-left: 74px; margin-top: 19px;"/>
                </ui:Button>
