                    <ui:Image name="Icon" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sources/Tiny%20Swords/Buildings/Black%20Buildings/House2.png?fileID=21300000&amp;guid=cb445ff62c7c14026925f63218d44e2a&amp;type=3#House2&quot;); -unity-background-scale-mode: scale-to-fit; margin-bottom: 22px; left: 0; width: 100px; margin-left: 74px; margin-top: 19px;"/>
                </ui:Button>
                <ui:Button text="EXIT" name="ArcherTower" picking-mode="Ignore" class="button commonText" style="margin-left: 25px;">
                    <ui:Image name="Icon" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sources/Tiny%20Swords/UI%20Elements/Icons/Icon_08.png?fileID=21300000&amp;guid=fae718ae59ba4491e94b6063a1d127ab&amp;type=3#Icon_08&quot;); -unity-background-scale-mode: scale-to-fit; margin-bottom: 22px; left: 0; width: 100px; margin-left: 74px; margin-top: 19px;"/>
                </ui:Button>
