}

.tower-icon-ice {
    background-image: url("project://database/Assets/Sources/My/Towers/IceTower/IceTowerLvl1.png?fileID=2800000&guid=5fdd65c9ff91f634d88404bbebc2a074&type=3#IceTowerLvl1");
}

.tower-icon-fire {
    background-image: url("project://database/Assets/Sources/My/Towers/FireTower/FireTowerLvl1.png?fileID=2800000&guid=57f518205be7e1c4490654ddb95779df&type=3#FireTowerLvl1");
}

.wave-call__icon {
    width: 84px;
