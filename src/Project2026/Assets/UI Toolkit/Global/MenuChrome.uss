    background-image: url("project://database/Assets/Sources/Tiny%20Swords%20(Free%20Pack)/Tiny%20Swords%20(Free%20Pack)/UI%20Elements/UI%20Elements/Icons/Icon_07.png?fileID=2800000&guid=547686f4269777f44b5e2233675497c2&type=3#Icon_07");
}

