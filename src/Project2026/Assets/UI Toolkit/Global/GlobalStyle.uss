.button {
    translate: 0 -5%;
    width: 500px;
    height: 150px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    opacity: 1;
    background-image: url("project://database/Assets/Sources/Tiny%20Swords%20(Free%20Pack)/Tiny%20Swords%20(Free%20Pack)/UI%20Elements/UI%20Elements/Wood%20Table/WoodTable_Slots.png?fileID=2800000&guid=922213a7128e89d4a9e89e3f1c689ae9&type=3#WoodTable_Slots");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    -unity-background-scale-mode: stretch-to-fill;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    cursor: url("project://database/Assets/UI%20Toolkit/Cursors/HandCursor.png?fileID=2800000&guid=c4e8a1d27b6f4a0e9c3d5f18a2b74e60&type=3") 5 1;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.button:hover:enabled {
    scale: 1.04 1.04;
    -unity-background-image-tint-color: rgb(255, 236, 210);
}

.button:active:enabled {
    scale: 0.97 0.97;
    -unity-background-image-tint-color: rgb(190, 160, 130);
}

.button:disabled {
    -unity-background-image-tint-color: rgb(140, 140, 140);
    opacity: 0.55;
}

.commonText {
    color: rgb(82, 24, 7);
    font-size: 40px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/ThaleahFat%20SDF.asset?fileID=11400000&guid=4f91cd89f157d37449660700b7886222&type=2#ThaleahFat SDF");
    -unity-text-outline-color: rgb(214, 183, 152);
    -unity-text-outline-width: 1.5px;
    -unity-font-style: normal;
    text-overflow: clip;
}

.margin {
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
}

.titleText {
    color: rgb(82, 24, 7);
    font-size: 113px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/ThaleahFat%20SDF.asset?fileID=11400000&guid=4f91cd89f157d37449660700b7886222&type=2#ThaleahFat SDF");
    -unity-text-outline-color: rgb(214, 183, 152);
    -unity-text-outline-width: 2px;
}

.tower-slot {
    cursor: url("project://database/Assets/UI%20Toolkit/Cursors/HandCursor.png?fileID=2800000&guid=c4e8a1d27b6f4a0e9c3d5f18a2b74e60&type=3") 5 1;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-cubic;
}

.tower-slot:hover:enabled {
    scale: 1.04 1.04;
    -unity-background-image-tint-color: rgb(255, 236, 210);
}

.tower-slot:active:enabled {
    scale: 0.97 0.97;
    -unity-background-image-tint-color: rgb(190, 160, 130);
}

.tower-slot:disabled {
    -unity-background-image-tint-color: rgb(140, 140, 140);
    opacity: 0.55;
}

.hide {
    opacity: 0;
    visibility: visible;
}
